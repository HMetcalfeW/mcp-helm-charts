{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "mode": {
      "type": "string",
      "enum": ["supergateway", "native"],
      "description": "Deployment mode: 'supergateway' wraps stdio servers, 'native' runs HTTP servers directly"
    },
    "command": {
      "type": "string",
      "description": "The stdio MCP server command that supergateway wraps (supergateway mode only)"
    },
    "nativeCommand": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Container command for native mode (e.g., [\"mcp\", \"run\"])"
    },
    "nativeArgs": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Container args for native mode"
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string" },
        "tag": { "type": "string" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "server": {
      "type": "object",
      "properties": {
        "transport": {
          "type": "string",
          "enum": ["streamableHttp", "sse"],
          "description": "Output transport protocol (supergateway mode only)"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "healthEndpoint": {
          "type": "string",
          "description": "Health check endpoint path"
        },
        "extraArgs": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 0
    },
    "service": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "env": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "existingSecret": {
      "type": "string"
    },
    "resources": { "type": "object" },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object" }
      }
    }
  }
}
